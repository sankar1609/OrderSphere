<?xml version="1.0" encoding="UTF-8"?>
<!--
  Shared logging setup for every OrderSphere application (picked up automatically from
  common-logging's jar). LOG_FORMAT selects the console format (both appenders are attached;
  LogFormatFilter lets exactly one of them write):
    text (default) - Spring Boot's usual readable pattern, for running locally and in tests;
    json           - one JSON object per line, for Loki (set in docker-compose and k8s).
  JSON lines carry the service name and every MDC entry: traceId/spanId from Micrometer Tracing,
  and user/orderId/paymentId where the code puts them.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProperty scope="local" name="LOG_FORMAT" source="LOG_FORMAT" defaultValue="text"/>
    <springProperty scope="local" name="SERVICE_NAME" source="spring.application.name"
                    defaultValue="application"/>

    <appender name="text" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="com.ordersphere.logging.LogFormatFilter">
            <active>${LOG_FORMAT}</active>
            <format>text</format>
        </filter>
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>${CONSOLE_LOG_CHARSET}</charset>
        </encoder>
    </appender>

    <appender name="json" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="com.ordersphere.logging.LogFormatFilter">
            <active>${LOG_FORMAT}</active>
            <format>json</format>
        </filter>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeContext>false</includeContext>
            <customFields>{"service":"${SERVICE_NAME}"}</customFields>
            <fieldNames>
                <logger>logger</logger>
                <thread>thread</thread>
                <version>[ignore]</version>
                <levelValue>[ignore]</levelValue>
            </fieldNames>
            <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                <maxDepthPerThrowable>30</maxDepthPerThrowable>
                <rootCauseFirst>true</rootCauseFirst>
            </throwableConverter>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="text"/>
        <appender-ref ref="json"/>
    </root>
</configuration>
