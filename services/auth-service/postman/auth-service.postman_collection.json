{
  "info": {
    "name": "OrderSphere - auth-service",
    "description": "Manual test collection for auth-service: register, login, protected /me, and admin-only role promotion.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8081" },
    { "key": "token", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "registeredUserId", "value": "" }
  ],
  "item": [
    {
      "name": "Register - Customer",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"alice\",\n  \"password\": \"password123\",\n  \"role\": \"CUSTOMER\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
        "description": "Self-registers a CUSTOMER. Expect 201 with {id, username, role}. Change the username to re-run (usernames are unique)."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201) {",
              "    pm.collectionVariables.set('registeredUserId', pm.response.json().id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Register - Rejected (Admin role)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"wannabe-admin\",\n  \"password\": \"password123\",\n  \"role\": \"ADMIN\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
        "description": "ADMIN/AUDITOR cannot be self-assigned at registration. Expect 400."
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"alice\",\n  \"password\": \"password123\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
        "description": "Expect 200 with {token, tokenType, expiresInSeconds}. Saves the token into the {{token}} collection variable for use by 'Me'."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    pm.collectionVariables.set('token', pm.response.json().token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Me",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] },
        "description": "Requires a valid token (run Login first). Expect 200 with the current user. Remove the Authorization header to confirm you get 401 instead."
      }
    },
    {
      "name": "Admin Login (bootstrap)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
        "description": "Logs in as the default bootstrap admin created automatically on auth-service's first startup (env-configurable via ADMIN_BOOTSTRAP_USERNAME/PASSWORD). Saves the token into {{adminToken}}."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    pm.collectionVariables.set('adminToken', pm.response.json().token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Promote User Role (admin-only)",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"role\": \"VENDOR\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/admin/users/{{registeredUserId}}/role",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "admin", "users", "{{registeredUserId}}", "role"]
        },
        "description": "Run 'Register - Customer' and 'Admin Login' first. Expect 200 with the updated role. Swap the Authorization header to a non-admin {{token}} to confirm you get 403 instead."
      }
    }
  ]
}
