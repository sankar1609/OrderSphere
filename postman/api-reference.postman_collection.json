{
  "info": {
    "name": "OrderSphere - API Reference",
    "description": "One request per endpoint across all six services, hit directly on their own ports (not through the gateway). This is a reference/exploration collection, not a guided flow - see full-order-flow.postman_collection.json for an end-to-end saga walkthrough. Folders are ordered so the whole collection runs cleanly top-to-bottom via Collection Runner (each folder is labeled with its port for lookup, but the folder *sequence* reflects setup dependencies, not port number - e.g. Inventory setup runs before Orders because Create Order needs an existing product). The standalone Reserve/Confirm/Release Reservation and Initiate/Get/Refund Payment requests operate on a fixed {{demoOrderId}} rather than a real order's {{orderId}}, since inventory-service and payment-service don't cross-validate orderId against ordersphere-orders (database-per-service, no cross-service FKs) - this lets those folders run standalone without waiting on the Orders folder, and mirrors how ordersphere-orders itself calls them internally (both are idempotent per-orderId, so re-running this collection is safe).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "authBaseUrl", "value": "http://localhost:8081" },
    { "key": "ordersBaseUrl", "value": "http://localhost:8082" },
    { "key": "inventoryBaseUrl", "value": "http://localhost:8083" },
    { "key": "paymentBaseUrl", "value": "http://localhost:8084" },
    { "key": "shippingBaseUrl", "value": "http://localhost:8085" },
    { "key": "notificationBaseUrl", "value": "http://localhost:8086" },
    { "key": "customerToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "productSku", "value": "SKU-1001" },
    { "key": "demoOrderId", "value": "900001" },
    { "key": "orderId", "value": "" },
    { "key": "paymentId", "value": "" },
    { "key": "checkoutUrl", "value": "" },
    { "key": "shipmentId", "value": "" },
    { "key": "notificationId", "value": "" },
    { "key": "preferenceId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Auth Service (:8081)",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"alice\",\n  \"password\": \"SecurePass123\",\n  \"role\": \"CUSTOMER\"\n}"
            },
            "url": { "raw": "{{authBaseUrl}}/auth/register", "host": ["{{authBaseUrl}}"], "path": ["auth", "register"] },
            "description": "role: CUSTOMER | VENDOR | ADMIN | AUDITOR. Expect 201; 409 if the username already exists (safe to ignore and continue - Login Customer below doesn't depend on this succeeding)."
          }
        },
        {
          "name": "Login Customer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"alice\",\n  \"password\": \"SecurePass123\"\n}"
            },
            "url": { "raw": "{{authBaseUrl}}/auth/login", "host": ["{{authBaseUrl}}"], "path": ["auth", "login"] },
            "description": "Saves the returned JWT into {{customerToken}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set('customerToken', pm.response.json().token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": { "raw": "{{authBaseUrl}}/auth/login", "host": ["{{authBaseUrl}}"], "path": ["auth", "login"] },
            "description": "admin/admin123 is the bootstrap admin auto-created by AdminBootstrapRunner on auth-service's first startup against a fresh database. Saves the returned JWT into {{adminToken}}. Used for every ADMIN/VENDOR-only endpoint below."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set('adminToken', pm.response.json().token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": { "raw": "{{authBaseUrl}}/auth/me", "host": ["{{authBaseUrl}}"], "path": ["auth", "me"] },
            "description": "Also saves {{userId}} (alice's id) for the role-change request below - more reliable than reading it off Register, which may 409 on repeat runs."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set('userId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Change User Role (Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"VENDOR\"\n}"
            },
            "url": {
              "raw": "{{authBaseUrl}}/auth/admin/users/{{userId}}/role",
              "host": ["{{authBaseUrl}}"],
              "path": ["auth", "admin", "users", "{{userId}}", "role"]
            },
            "description": "role: CUSTOMER | VENDOR | ADMIN | AUDITOR. Promotes alice to VENDOR - her already-issued {{customerToken}} still carries the CUSTOMER role claim from login time, so this doesn't affect the rest of the run. Note this is a real, persistent change to alice's role in the database."
          }
        }
      ]
    },
    {
      "name": "2. Inventory Service (:8083)",
      "item": [
        {
          "name": "Create Product (Admin/Vendor)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"{{productSku}}\",\n  \"name\": \"Wireless Mouse\",\n  \"quantityOnHand\": 100,\n  \"reorderThreshold\": 10,\n  \"unitPrice\": 24.99\n}"
            },
            "url": { "raw": "{{inventoryBaseUrl}}/inventory/products", "host": ["{{inventoryBaseUrl}}"], "path": ["inventory", "products"] },
            "description": "Expect 201; 409 if {{productSku}} already exists from a previous run - safe to ignore, the Orders folder just needs the product to exist either way."
          }
        },
        {
          "name": "List Products",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": { "raw": "{{inventoryBaseUrl}}/inventory/products", "host": ["{{inventoryBaseUrl}}"], "path": ["inventory", "products"] }
          }
        },
        {
          "name": "Get Product By SKU",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": {
              "raw": "{{inventoryBaseUrl}}/inventory/products/{{productSku}}",
              "host": ["{{inventoryBaseUrl}}"],
              "path": ["inventory", "products", "{{productSku}}"]
            }
          }
        },
        {
          "name": "Restock (Admin/Vendor)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 50\n}"
            },
            "url": {
              "raw": "{{inventoryBaseUrl}}/inventory/products/{{productSku}}/restock",
              "host": ["{{inventoryBaseUrl}}"],
              "path": ["inventory", "products", "{{productSku}}", "restock"]
            }
          }
        },
        {
          "name": "Reserve Stock",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": {{demoOrderId}},\n  \"items\": [{ \"sku\": \"{{productSku}}\", \"quantity\": 2 }]\n}"
            },
            "url": { "raw": "{{inventoryBaseUrl}}/inventory/reservations", "host": ["{{inventoryBaseUrl}}"], "path": ["inventory", "reservations"] },
            "description": "Normally called internally by ordersphere-orders during order creation - exercised here directly against {{demoOrderId}} (a fixed standalone id, not a real order) so this folder doesn't depend on the Orders folder having run. Idempotent: re-running returns the existing reservation instead of erroring."
          }
        },
        {
          "name": "Confirm Reservation",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": {
              "raw": "{{inventoryBaseUrl}}/inventory/reservations/{{demoOrderId}}/confirm",
              "host": ["{{inventoryBaseUrl}}"],
              "path": ["inventory", "reservations", "{{demoOrderId}}", "confirm"]
            }
          }
        },
        {
          "name": "Release Reservation",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": {
              "raw": "{{inventoryBaseUrl}}/inventory/reservations/{{demoOrderId}}/release",
              "host": ["{{inventoryBaseUrl}}"],
              "path": ["inventory", "reservations", "{{demoOrderId}}", "release"]
            },
            "description": "Releasing a CONFIRMED reservation (as just set by Confirm above) is valid - release() only special-cases already-RELEASED/EXPIRED reservations as a no-op, any other status is released normally."
          }
        }
      ]
    },
    {
      "name": "3. Payment Service (:8084)",
      "item": [
        
        
        
        
        {
          "name": "Initiate Payment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": {{demoOrderId}},\n  \"amount\": 49.98,\n  \"currency\": \"USD\"\n}"
            },
            "url": { "raw": "{{paymentBaseUrl}}/payments", "host": ["{{paymentBaseUrl}}"], "path": ["payments"] },
            "description": "Normally called internally by ordersphere-orders during order creation - exercised here directly against {{demoOrderId}} so this folder doesn't depend on the Orders folder having run. Idempotent: re-running returns the existing payment. Saves {{paymentId}} and {{checkoutUrl}}. Expect 202 - the payment starts PENDING with a checkoutUrl on the payment provider's hosted page (the dummy gateway, http://localhost:8087). It only becomes COMPLETED once someone pays there: open {{checkoutUrl}} in a browser and use test card 4242 4242 4242 4242."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 202) {",
                  "    pm.collectionVariables.set('paymentId', pm.response.json().id);",
                  "    pm.collectionVariables.set('checkoutUrl', pm.response.json().checkoutUrl);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Payment",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": { "raw": "{{paymentBaseUrl}}/payments/{{paymentId}}", "host": ["{{paymentBaseUrl}}"], "path": ["payments", "{{paymentId}}"] }
          }
        },
        {
          "name": "Refund Payment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Customer requested cancellation\"\n}"
            },
            "url": {
              "raw": "{{paymentBaseUrl}}/payments/{{paymentId}}/refund",
              "host": ["{{paymentBaseUrl}}"],
              "path": ["payments", "{{paymentId}}", "refund"]
            },
            "description": "PaymentService only allows refunding a COMPLETED payment. Straight after Initiate Payment this legitimately returns 409 - the payment stays PENDING until someone pays on {{checkoutUrl}}. Pay there first (test card 4242 4242 4242 4242), then re-send to see the 202 success path."
          }
        }
      ]
    },
    {
      "name": "4. Orders Service (:8082)",
      "item": [
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [{ \"sku\": \"{{productSku}}\", \"quantity\": 2 }],\n  \"currency\": \"USD\",\n  \"shippingDestination\": \"123 Main St, Springfield\"\n}"
            },
            "url": { "raw": "{{ordersBaseUrl}}/orders", "host": ["{{ordersBaseUrl}}"], "path": ["orders"] },
            "description": "Needs the product created in folder 2. Expect 201 with status AWAITING_PAYMENT and a checkoutUrl: stock is reserved and a checkout session is opened with the payment provider inside this call, but nothing is charged until the customer pays on {{checkoutUrl}} (open it in a browser; test card 4242 4242 4242 4242). Saves {{orderId}} and {{checkoutUrl}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('orderId', pm.response.json().id);",
                  "    pm.collectionVariables.set('checkoutUrl', pm.response.json().checkoutUrl);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List My Orders",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": { "raw": "{{ordersBaseUrl}}/orders", "host": ["{{ordersBaseUrl}}"], "path": ["orders"] }
          }
        },
        {
          "name": "Get Order",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": { "raw": "{{ordersBaseUrl}}/orders/{{orderId}}", "host": ["{{ordersBaseUrl}}"], "path": ["orders", "{{orderId}}"] }
          }
        }
      ]
    },
    {
      "name": "5. Shipping Service (:8085)",
      "item": [
        {
          "name": "Create Shipment (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": {{orderId}},\n  \"destination\": \"123 Main St, Springfield\"\n}"
            },
            "url": { "raw": "{{shippingBaseUrl}}/shipments", "host": ["{{shippingBaseUrl}}"], "path": ["shipments"] },
            "description": "Normally ordersphere-orders creates the shipment itself once payment settles (via its own ~5s OrderSagaProgressJob sweep) - calling this directly, right after Create Order above, gets there first in a fast run. Uses the real {{orderId}} from the Orders folder. Saves {{shipmentId}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('shipmentId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Shipment",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": { "raw": "{{shippingBaseUrl}}/shipments/{{shipmentId}}", "host": ["{{shippingBaseUrl}}"], "path": ["shipments", "{{shipmentId}}"] }
          }
        },
        {
          "name": "Get Shipment Tracking",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": {
              "raw": "{{shippingBaseUrl}}/shipments/{{shipmentId}}/tracking",
              "host": ["{{shippingBaseUrl}}"],
              "path": ["shipments", "{{shipmentId}}", "tracking"]
            }
          }
        },
        {
          "name": "List Shipments By Order",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": {
              "raw": "{{shippingBaseUrl}}/shipments/order/{{orderId}}",
              "host": ["{{shippingBaseUrl}}"],
              "path": ["shipments", "order", "{{orderId}}"]
            }
          }
        },
        {
          "name": "Request Return",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Item damaged in transit\"\n}"
            },
            "url": {
              "raw": "{{shippingBaseUrl}}/shipments/{{shipmentId}}/return",
              "host": ["{{shippingBaseUrl}}"],
              "path": ["shipments", "{{shipmentId}}", "return"]
            },
            "description": "ShipmentService only allows a return once the shipment's status is DELIVERED. Run right after Create Shipment above, the shipment is still CREATED, so this legitimately returns an error - shipping-service progresses CREATED -> PICKED -> IN_TRANSIT -> DELIVERED one stage per sweep. Re-send after the shipment has had time to progress (check via Get Shipment) to see the success path."
          }
        }
      ]
    },
    {
      "name": "6. Notification Service (:8086)",
      "item": [
        {
          "name": "Create Notification (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recipientUsername\": \"alice\",\n  \"channel\": \"EMAIL\",\n  \"templateKey\": \"ORDER_CONFIRMED\",\n  \"variables\": { \"orderId\": \"{{orderId}}\" }\n}"
            },
            "url": { "raw": "{{notificationBaseUrl}}/notifications", "host": ["{{notificationBaseUrl}}"], "path": ["notifications"] },
            "description": "channel: EMAIL | SMS | IN_APP | PUSH. templateKey: ORDER_CONFIRMED | ORDER_CANCELLED | PAYMENT_COMPLETED | PAYMENT_FAILED | SHIPMENT_CREATED | DELIVERY_CONFIRMED. Saves {{notificationId}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('notificationId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List My Notifications",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": { "raw": "{{notificationBaseUrl}}/notifications", "host": ["{{notificationBaseUrl}}"], "path": ["notifications"] }
          }
        },
        {
          "name": "Get Notification",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": {
              "raw": "{{notificationBaseUrl}}/notifications/{{notificationId}}",
              "host": ["{{notificationBaseUrl}}"],
              "path": ["notifications", "{{notificationId}}"]
            }
          }
        },
        {
          "name": "Set Notification Preference",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"channel\": \"EMAIL\",\n  \"enabled\": true\n}"
            },
            "url": {
              "raw": "{{notificationBaseUrl}}/notification-preferences",
              "host": ["{{notificationBaseUrl}}"],
              "path": ["notification-preferences"]
            },
            "description": "Saves {{preferenceId}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set('preferenceId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List My Preferences",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": {
              "raw": "{{notificationBaseUrl}}/notification-preferences",
              "host": ["{{notificationBaseUrl}}"],
              "path": ["notification-preferences"]
            }
          }
        },
        {
          "name": "Delete Preference",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": {
              "raw": "{{notificationBaseUrl}}/notification-preferences/{{preferenceId}}",
              "host": ["{{notificationBaseUrl}}"],
              "path": ["notification-preferences", "{{preferenceId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "7. Cleanup",
      "item": [
        {
          "name": "Cancel Order",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": {
              "raw": "{{ordersBaseUrl}}/orders/{{orderId}}/cancel",
              "host": ["{{ordersBaseUrl}}"],
              "path": ["orders", "{{orderId}}", "cancel"]
            },
            "description": "Deliberately last in the run: cancelling {{orderId}} here (rather than immediately after Create Order) means the Shipping folder above still gets a live order to attach a shipment to. Expect 200 with status CANCELLED; safe to re-send, cancellation is idempotent."
          }
        }
      ]
    }
  ]
}
