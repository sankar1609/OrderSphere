# Shared, non-secret settings for every OrderSphere service (envFrom on each Deployment). The host
# names are the in-cluster Service names - the same as in docker-compose.
DB_HOST=postgres
RABBITMQ_HOST=rabbitmq
EUREKA_URI=http://service-registry:8761/eureka
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://service-registry:8761/eureka
OTLP_TRACING_ENDPOINT=http://jaeger:4318/v1/traces
TRACING_SAMPLING_PROBABILITY=1.0
# One JSON object per line (common-logging), collected into Loki by Alloy.
LOG_FORMAT=json
# Where the browser is sent back after paying (the Web UI dev server on the host).
PAYMENT_RETURN_URL=http://localhost:5173/
# Base URL browsers use to open the dummy provider's checkout page (published on the host).
GATEWAY_PUBLIC_URL=http://localhost:8087
